# Variables de entorno para producción (Railway, Render, Fly.io, etc).
# Copiá este archivo a .env para desarrollo local si querés probar con tus
# propios valores — .env está en .gitignore, nunca se commitea.

# Contraseña para entrar a /admin. Si no se define, se usa "suzuki2026"
# (la contraseña de desarrollo) — cambiala antes de publicar el sitio.
ADMIN_PASSWORD=

# Clave para firmar la cookie de sesión del panel de admin. Tiene que tener
# al menos 32 caracteres. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
