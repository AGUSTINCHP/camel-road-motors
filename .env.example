# Variables de entorno.
#
# Las que empiezan con SUPABASE_ / VITE_SUPABASE_ las gestiona Lovable Cloud
# solo (Project Settings del editor de Lovable) — no hace falta setearlas
# a mano, ni acá ni en ningún panel de hosting.
#
# Las dos de abajo sí son tuyas: configuralas en Lovable (Project Settings →
# Environment Variables) antes de publicar el sitio.

# Contraseña para entrar a /admin. Si no se define, se usa "suzuki2026"
# (la contraseña de desarrollo) — cambiala antes de publicar el sitio.
ADMIN_PASSWORD=

# Clave para firmar la cookie de sesión del panel de admin. Tiene que tener
# al menos 32 caracteres. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
